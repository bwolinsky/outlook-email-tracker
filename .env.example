# ── Outlook / Microsoft 365 IMAP ─────────────────────────────────────────────
# Enable IMAP in Outlook: Settings > Mail > Sync email > IMAP
# For personal Outlook.com: https://support.microsoft.com/en-us/office/pop-imap-and-smtp-settings-8361e398-8af4-4e97-b147-6c6c4ac95353
# For Microsoft 365 work accounts: ask your admin to enable IMAP, or use an App Password.
IMAP_EMAIL=you@outlook.com
IMAP_PASSWORD=your-password-or-app-password
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_PORT=5000

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to check for new emails (minutes)
POLL_INTERVAL_MINUTES=5
# Max emails fetched per poll cycle
MAX_EMAILS_PER_POLL=50
