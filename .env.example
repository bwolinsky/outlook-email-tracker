# Microsoft Azure App Registration
# Register at https://portal.azure.com -> Azure Active Directory -> App registrations
AZURE_CLIENT_ID=your-azure-app-client-id-here
AZURE_TENANT_ID=common  # Use 'common' for personal/work accounts, or your tenant ID

# Anthropic API Key
# Get at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_PORT=5000

# Polling interval in minutes (how often to check for new emails)
POLL_INTERVAL_MINUTES=5

# Max emails to fetch per poll cycle
MAX_EMAILS_PER_POLL=50

# SQLite database path
DATABASE_PATH=email_tracker.db

# Token cache file path
TOKEN_CACHE_PATH=.token_cache.json
